@model List<LibraryManagement.Web.Models.BookViewModel>

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>📚 Books</h2>

    <div>
        <a asp-action="History"
           class="btn btn-info">
            View History
        </a>

        <a asp-action="TopIssued"
            class="btn btn-warning">
            Top Issued
        </a>

        <a asp-action="Add"
           class="btn btn-success">
            + Add Book
        </a>
    </div>

</div>

<form method="get" class="mb-4">

    <div class="input-group">

        <input type="text"
               name="searchTerm"
               class="form-control"
               placeholder="Search by title..."
               value="@ViewBag.SearchTerm" />

        <button type="submit"
                class="btn btn-primary">
            Search
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Clear
        </a>

    </div>

</form>

<table class="table table-dark table-striped table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Author</th>
            <th>Available Copies</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

    @foreach (var book in Model)
    {
        <tr>
            <td>@book.Id</td>
            <td>@book.Title</td>
            <td>@book.Author</td>
            <td>@book.AvailableCopies</td>

            <td>

                <a asp-action="Edit"
                   asp-route-id="@book.Id"
                   class="btn btn-warning btn-sm">
                    Edit
                </a>

                <form asp-action="Delete"
                      method="post"
                      style="display:inline;">

                    <input type="hidden"
                           name="id"
                           value="@book.Id" />

                    <button type="submit"
                            class="btn btn-danger btn-sm">
                        Delete
                    </button>

                </form>

                <form asp-action="Issue"
                    method="post"
                    style="display:inline;">

                    <input type="hidden"
                        name="id"
                        value="@book.Id" />

                    <button type="submit"
                        class="btn btn-info btn-sm">
                    Issue
                    </button>

                </form>

                <form asp-action="Return"
                    method="post"
                    style="display:inline;">

                    <input type="hidden"
                        name="id"
                        value="@book.Id" />

                    <button type="submit"
                        class="btn btn-success btn-sm">
                    Return
                    </button>

                </form>

            </td>
        </tr>
    }

    </tbody>
</table>