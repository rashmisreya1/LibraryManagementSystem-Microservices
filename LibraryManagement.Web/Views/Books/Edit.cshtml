@model LibraryManagement.Web.Models.BookViewModel

<div class="row justify-content-center">

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-header bg-warning text-dark">
                <h3 class="mb-0">✏️ Edit Book</h3>
            </div>

            <div class="card-body">

                <form method="post">

                    <input asp-for="Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Author" class="form-label"></label>
                        <input asp-for="Author" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="AvailableCopies" class="form-label"></label>
                        <input asp-for="AvailableCopies" class="form-control" />
                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-warning">
                            Save Changes
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Back
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>