@model LibraryManagement.Web.Models.SignupRequest

<div class="row justify-content-center">

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-header bg-success text-white">

                <h2>📝 Sign Up</h2>

            </div>

            <div class="card-body">

                <form method="post">

                    <div class="mb-3">
                        <label>Name</label>
                        <input asp-for="Name" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Email</label>
                        <input asp-for="Email" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Password</label>
                        <input asp-for="Password"
                               type="password"
                               class="form-control" />
                    </div>

                    <button type="submit"
                            class="btn btn-success">
                        Sign Up
                    </button>

                    <a asp-action="Login"
                       class="btn btn-secondary">
                        Back to Login
                    </a>

                </form>

                @if (ViewBag.Message != null)
                {
                    <div class="mt-3 alert alert-danger">
                        @ViewBag.Message
                    </div>
                }

            </div>

        </div>

    </div>

</div>