@model LibraryManagement.Web.Models.BookViewModel

<h2>Edit Book</h2>

<form method="post">

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label>Title</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Author</label>
        <input asp-for="Author" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Available Copies</label>
        <input asp-for="AvailableCopies"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-warning">
        Update
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>