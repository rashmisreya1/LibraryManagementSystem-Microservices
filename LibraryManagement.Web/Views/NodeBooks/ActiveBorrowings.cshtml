@model List<LibraryManagement.Web.Models.ActiveBorrowingViewModel>

<h2>📚 Active Borrowings</h2>

<table class="table table-dark table-striped">

    <thead>
        <tr>
            <th>Book</th>
            <th>User</th>
            <th>Issue Date</th>
        </tr>
    </thead>

    <tbody>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.UserId</td>
            <td>@item.IssueDate</td>
        </tr>
    }

    </tbody>

</table>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>