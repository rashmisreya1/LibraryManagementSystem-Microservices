@model List<LibraryManagement.Web.Models.BookViewModel>

@{
    ViewData["Title"] = "NodeJS Books";
}

<h1 class="mb-4">🟢 NodeJS Books Portal</h1>

<form method="get" class="mb-4">

    <div class="input-group">

        <input type="text"
               name="searchTerm"
               class="form-control"
               placeholder="Search by title..."
               value="@ViewBag.SearchTerm" />

        <button type="submit"
                class="btn btn-primary">
            Search
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Clear
        </a>

    </div>

</form>

<div class="mb-3">

    <a asp-controller="NodeBooks"
        asp-action="History"
        class="btn btn-info">
        📜 History
    </a>

    <a asp-controller="NodeBooks"
        asp-action="ActiveBorrowings"
        class="btn btn-warning">
        📚 Active Borrowings
    </a>

    <a asp-action="TopIssued"
        class="btn btn-warning">
        Top Issued
    </a>

    <a asp-controller="NodeBooks"
       asp-action="Add"
       class="btn btn-success">
        ➕ Add Book
    </a>

</div>

<table class="table table-striped table-bordered">

    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Author</th>
            <th>Available Copies</th>
            <th width="220">Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Id</td>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.AvailableCopies</td>

                <td>

                    <a asp-controller="NodeBooks"
                       asp-action="Edit"
                       asp-route-id="@book.Id"
                       class="btn btn-warning btn-sm">
                        ✏ Edit
                    </a>

                    <a asp-controller="NodeBooks"
                       asp-action="Delete"
                       asp-route-id="@book.Id"
                       class="btn btn-danger btn-sm">
                        🗑 Delete
                    </a>

                </td>
            </tr>
        }

    </tbody>

</table>