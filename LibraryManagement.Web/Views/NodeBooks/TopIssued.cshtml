@model List<LibraryManagement.Web.Models.NodeTopIssuedBookViewModel>

@{
    ViewData["Title"] = "Top Issued Books";
}

<h1 class="mb-4">🏆 Top Issued Books</h1>

<table class="table table-dark table-striped">

    <thead>
        <tr>
            <th>Book</th>
            <th>Total Issues</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.IssueCount</td>
            </tr>
        }

    </tbody>

</table>

<a asp-action="Dashboard"
   class="btn btn-secondary">
    Back
</a>